# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hoopsengine
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hoopsengine_test

# Redis (rate limiting). Use memory:// in tests if Redis is unavailable.
REDIS_URL=redis://127.0.0.1:6379/0

# App
ENVIRONMENT=development
SECRET_KEY=change-me
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# JWT / OAuth2 (JWT_SECRET_KEY is canonical; JWT_SECRET is accepted as an alias)
JWT_SECRET_KEY=change-me
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_STRATEGY=jwt
LOGIN_RATE_LIMIT=60/minute

# Initial Super Admin seed (used by scripts/seed_super_admin.py)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe1!

# Amazon SES (email adapter). Leave keys empty to disable sending in local/dev.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@example.com
SES_CONFIGURATION_SET=

# Client redirect after login
DASHBOARD_PATH=/dashboard

# Auth0 adapter (not used for Super Admin password login when AUTH_STRATEGY=jwt)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_WEBHOOK_SECRET=
AUTH0_ENVIRONMENT=

# Billing / subscription adapter
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=
