# Database connection strings (async SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hoopsengine
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hoopsengine_test

# JWT / OAuth2
# JWT_SECRET_KEY is canonical; JWT_SECRET is accepted as an alias.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# HTTP
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO
LOGIN_RATE_LIMIT=60/minute
DASHBOARD_PATH=/dashboard

# Initial Super Admin (used by scripts/seed_super_admin.py)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe1!

# Auth0 (webhooks / sandbox vs production — login itself is local OAuth2/JWT)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_WEBHOOK_SECRET=
AUTH0_SANDBOX_DOMAIN=

# Billing webhooks
BILLING_WEBHOOK_SECRET=

# Amazon SES (email)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
